# Reference only: replace YOUR_USER and preserve real installed paths.
[Unit]
Description=AARTINS worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/aartins
EnvironmentFile=/home/YOUR_USER/aartins/worker.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/YOUR_USER/aartins/.venv/bin/python /home/YOUR_USER/aartins/meeting_worker.py
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
