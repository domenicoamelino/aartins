# Copy privately as worker.env; replace the placeholder before starting.
MEETING_API_KEY=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Set an absolute data directory outside the checkout.
# MEETING_ROOT=/home/YOUR_USER/smartinis-data
MEETING_BIND=127.0.0.1
MEETING_PORT=8765
WHISPER_MODEL=large-v3
WHISPER_THREADS=8
REPORT_MODEL=qwen3.5:9b
REPORT_LANGUAGE=English
REPORT_TIMEOUT=1200
